    {
      "dot": "rose",
      "title": "Safety boundary",
      "items": [
        "Main wires HitlToolRegistry, so risky tool execution can require approval.",
        "ToolRegistry centralizes file, shell, web, browser, memory, skill, RAG, and snapshot tools."
      ]
    },
    {
      "dot": "violet",
      "title": "Implemented but separate",
